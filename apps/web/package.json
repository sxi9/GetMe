{
  "name": "@getme/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit -p .",
    "build:targets": "VITE_APP_TARGET=customer vite build && VITE_APP_TARGET=partner vite build && VITE_APP_TARGET=shop vite build"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor/app": "8.0.0",
    "@capacitor/camera": "8.0.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/geolocation": "8.0.0",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/push-notifications": "8.0.0",
    "@capacitor/splash-screen": "8.0.0",
    "@capacitor/status-bar": "8.0.0",
    "@getme/core": "workspace:*",
    "leaflet": "1.9.4",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/leaflet": "1.9.20",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
