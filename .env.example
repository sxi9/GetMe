# apps/api
PORT=4000
DATA_DIR=./data          # SQLite db + uploads live here
DEV_OTP=1234             # fixed sign-in code for development; set empty to generate real codes (wire an SMS provider in server.ts)
SIM_BOTS=1               # seeded demo partners act like the prototype bots; set 0 in production
SIM_SPEED=1              # <1 makes bots faster
LOG=1

# apps/web
VITE_API_URL=            # empty = same origin (Vite proxies /api and /ws to the API in dev)

# phase 2
SMS_PROVIDER=console     # console | msg91 | twilio  (MSG91_AUTH_KEY+MSG91_TEMPLATE_ID or TWILIO_SID+TWILIO_TOKEN+TWILIO_FROM)
CRYPTO_PROVIDER=sim      # sim | nowpayments (NOWPAYMENTS_API_KEY, NOWPAYMENTS_IPN_SECRET, PUBLIC_API_URL for the webhook)
VAPID_PUBLIC_KEY=        # generated and stored in the DB on first start when empty
VAPID_PRIVATE_KEY=
GEOCODER=nominatim       # nominatim (OpenStreetMap, cached, gazetteer fallback)
PUBLIC_URL=              # used in SMS tracking links
