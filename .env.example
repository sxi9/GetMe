# apps/api
PORT=4000
DATA_DIR=./data          # SQLite db + uploads live here
DEV_OTP=1234             # fixed sign-in code for development; set empty to generate real codes (wire an SMS provider in server.ts)
SIM_BOTS=1               # seeded demo partners act like the prototype bots; set 0 in production
SIM_SPEED=1              # <1 makes bots faster
LOG=1

# apps/web
VITE_API_URL=            # empty = same origin (Vite proxies /api and /ws to the API in dev)
